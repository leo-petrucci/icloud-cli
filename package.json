{
  "name": "icloud-cli",
  "version": "1.0.0",
  "description": "Network-only iCloud CLI experiments",
  "main": "dist/cli.js",
  "bin": {
    "icloud-cli": "dist/cli.js"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "login": "tsx src/cli.ts login",
